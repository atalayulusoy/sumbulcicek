generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
}

model Product {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String
  price         Decimal       @db.Decimal(10, 2)
  discountPrice Decimal?      @db.Decimal(10, 2)
  images        Json
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featured      Boolean       @default(false)
  stockStatus   ProductStatus @default(IN_STOCK)
  badge         String?
  deliveryInfo  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String
  image      String
  buttonText String
  buttonLink String
  theme      String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSettings {
  id               String   @id @default("site-settings")
  whatsappNumber   String
  instagram        String?
  address          String?
  phone            String?
  heroTitle        String?
  heroSubtitle     String?
  metaTitle        String?
  metaDescription  String?
  aboutTitle       String?
  aboutText        String?
  footerText       String?
  deliveryInfo     String?
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  homepageSections Json?
  updatedAt        DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
